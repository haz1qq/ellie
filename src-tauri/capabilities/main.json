{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main window may read and save non-sensitive preferences and hide to tray.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-bootstrap",
    "allow-save-settings",
    "allow-hide-to-tray"
  ]
}
